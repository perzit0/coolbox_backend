# Copie este archivo como .env y complete los valores. Nunca suba el .env a GitHub.
# Los valores en blanco son obligatorios en producción; los demás tienen un valor por defecto.

# --- Entorno ---
ENTORNO=desarrollo                      # produccion en Render (Render también se detecta solo)
DATABASE_URL=sqlite:///coolbox.db       # en Render: la cadena del Session Pooler de Supabase

# --- Seguridad (genere claves con: python -c "import secrets; print(secrets.token_urlsafe(48))") ---
SECRET_KEY=
JWT_SECRET_KEY=
JWT_HORAS=8
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174
PROXIES_CONFIABLES=1
MAX_PETICION_MB=3
LIMITE_LOGIN=10 per minute
LIMITE_CONSULTAS=30 per minute
LOGIN_MAX_INTENTOS=5
LOGIN_MINUTOS_BLOQUEO=10
PASSWORD_LONGITUD_MINIMA=8
PIN_TOKEN_SEGUNDOS=90
PIN_MAX_INTENTOS=3
PIN_MINUTOS_BLOQUEO=5

# --- Usuarios iniciales (solo se usan si la BD no tiene administrador / si se piden demos) ---
ADMIN_INICIAL_EMAIL=
ADMIN_INICIAL_PASSWORD=
SEED_USUARIOS_DEMO=0
DEMO_PASSWORD=
DEMO_PIN=

# --- Negocio ---
EMAIL_DOMAIN=coolbox.com.pe
IGV_RATE=0.18
ZONA_HORARIA_HORAS=-5
IMAGEN_MAX_KB=1100
CACHE_CATALOGO_SEGUNDOS=60
CUADRE_CIEGO=1
LIMITE_EFECTIVO_CAJA=1500
CAJA_FONDO_MAXIMO=5000
POS_PROVEEDOR=Niubiz
DEVOLUCION_DIAS_MAX=7

# --- SUNAT (API de facturación fact_api, entorno beta) ---
SUNAT_API_URL=http://127.0.0.1:8000
SUNAT_API_EMAIL=
SUNAT_API_PASSWORD=
SUNAT_SERIE_BOLETA=B001
SUNAT_SERIE_FACTURA=F001
SUNAT_SERIE_NC_BOLETA=BC01
SUNAT_SERIE_NC_FACTURA=FC01
# Reintentos al emitir y espera creciente entre ellos (segundos)
SUNAT_REINTENTOS=3
SUNAT_ESPERA=1
COMPROBANTES_DIR=comprobantes
# Copia en la nube de la carpeta de comprobantes (Supabase > Project Settings > API Keys).
# El disco de Render se borra en cada despliegue; sin estas variables solo queda la carpeta local.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
COMPROBANTES_BUCKET=comprobantes

# --- Consulta de DNI (RENIEC) y RUC (SUNAT) para autocompletar el cliente ---
# Token gratuito en https://decolecta.com (sin token, el nombre se escribe a mano)
CONSULTA_TOKEN=
CONSULTA_DNI_URL=https://api.decolecta.com/v1/reniec/dni?numero={numero}
CONSULTA_RUC_URL=https://api.decolecta.com/v1/sunat/ruc?numero={numero}

# --- Integración de clientes con el grupo pareado (ver docs/API_CLIENTES.md) ---
# Nombre de nuestro sistema en las respuestas de la API
INTEGRACION_SISTEMA=COOLBOX - Grupo 8
# Ida: quién puede leer o enviarnos clientes. "Nombre=clave" separados por coma.
# Genere cada clave con: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTEGRACION_API_KEYS=
LIMITE_INTEGRACION=60 per minute
# Vuelta: API de clientes del otro grupo
# Las empresas se agregan desde el panel (Integraciones). Estas variables solo crean la primera.
INTEGRACION_SOCIO_NOMBRE=Grupo 5
# Tamaño máximo aceptado de la respuesta del otro grupo (MB)
INTEGRACION_MAX_MB=5
# Llave para cifrar los tokens de las empresas (si falta se usa SECRET_KEY; no la cambies después)
CIFRADO_CLAVE=
# Clave del agente de respaldo local (la genera scripts/respaldo_local/instalar_respaldo.bat)
RESPALDO_API_KEY=
INTEGRACION_SOCIO_URL=
INTEGRACION_SOCIO_API_KEY=
INTEGRACION_SOCIO_HEADER=X-API-Key
INTEGRACION_SOCIO_ESQUEMA=
# Solo si su API pide iniciar sesión para obtener un token
INTEGRACION_SOCIO_LOGIN_URL=
INTEGRACION_SOCIO_USUARIO=
INTEGRACION_SOCIO_PASSWORD=
INTEGRACION_SOCIO_CAMPO_USUARIO=email
INTEGRACION_SOCIO_CAMPO_PASSWORD=password
# Solo si sus campos tienen nombres poco comunes. Ej.: {"nro_documento": "num_doc"}
INTEGRACION_SOCIO_MAPEO=
INTEGRACION_REINTENTOS=3
INTEGRACION_ESPERA_SEGUNDOS=2
INTEGRACION_TIMEOUT=55

# --- Tienda online (opcional) ---
GOOGLE_CLIENT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
